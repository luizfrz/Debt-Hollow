function M.has(name) return ART[name] ~= nil end

-- desenha o retrato dentro de 'canvas' (um Frame) e devolve a proporcao largura/altura
function M.paint(name, canvas)
	local a = ART[name]
	canvas.BackgroundColor3 = a.bg
	a.paint(painter(canvas, a.W, a.H))
	return a.W / a.H
end

return M
