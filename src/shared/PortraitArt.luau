-- PortraitArt: os retratos 2D de Augustus, Eleanora e Clara, desenhados com Frames (sem imagens).
-- Uso: local ratio = PortraitArt.paint('Clara', frame)  -- desenha dentro de 'frame'; ratio = largura/altura
local M = {}
local function C(r, g, b) return Color3.fromRGB(r, g, b) end
local GOLD = C(190, 150, 70)

local function painter(canvas, W, H)
	local Hu, z = H / W, 1
	local P = {}
	local function shape(cx, cy, w, h, color, o, round)
		o = o or {}
		local f = Instance.new('Frame')
		f.AnchorPoint = Vector2.new(0.5, 0.5)
		f.Position = UDim2.fromScale(cx, cy / Hu); f.Size = UDim2.fromScale(w, h / Hu)
		f.BackgroundColor3 = color; f.BorderSizePixel = 0; f.BackgroundTransparency = o.t or 0
		f.Rotation = o.rot or 0; f.ZIndex = z; z += 1
		if round then local c = Instance.new('UICorner'); c.CornerRadius = UDim.new(o.r or 0.5, 0); c.Parent = f end
		if o.grad then local g = Instance.new('UIGradient'); g.Color = ColorSequence.new(o.grad[1], o.grad[2]); g.Rotation = o.gr or 0; g.Parent = f end
		if o.stroke then local s = Instance.new('UIStroke'); s.Color = o.stroke[1]; s.Thickness = o.stroke[2]; s.Parent = f end
		f.Parent = canvas
		return f
	end
	function P.E(cx, cy, w, h, color, o) return shape(cx, cy, w, h, color, o, true) end
	function P.R(cx, cy, w, h, color, o) return shape(cx, cy, w, h, color, o, false) end
	return P
end

